# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─────────────────────────────────────────────────────────────
# MERCADO PAGO — Integración de Pagos con Tarjeta
# ─────────────────────────────────────────────────────────────

# VITE_MP_PUBLIC_KEY: Tu Public Key de Mercado Pago.
# ✅ Es seguro exponerla en el frontend (empieza con APP_ o TEST-).
# Obtenla en: https://www.mercadopago.com.mx/developers/panel/app
# Modo pruebas (Sandbox):  TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Modo producción:          APP-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_MP_PUBLIC_KEY="TEST-YOUR_PUBLIC_KEY_HERE"

# VITE_MP_CHECKOUT_LINK: Link de cobro directo de Mercado Pago (pre-generado).
# Si no configuras VITE_MP_BACKEND_URL, el checkout usará este link.
# Crea tu link en: https://www.mercadopago.com.mx/cobros
VITE_MP_CHECKOUT_LINK="https://mpago.la/1irRumY"

# VITE_MP_BACKEND_URL: URL de tu backend para crear preferencias dinámicas (opcional).
# Si está configurado, el checkout crea una preferencia personalizada con los items
# exactos del pedido (monto, evento, asientos). Requiere Access Token en el servidor.
# ⚠️ NUNCA pongas el Access Token en el frontend.
# Ejemplo: https://mi-backend.com
# VITE_MP_BACKEND_URL="https://mi-backend.com"
